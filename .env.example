# HuggingFace API Token (optional — only needed if using HF Inference API)
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Kaggle credentials (for dataset download)
# Get from: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Ollama (local LLM — install from https://ollama.ai, then: ollama pull gemma2:2b)
OLLAMA_MODEL=gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding + Reranker models (downloaded automatically from HuggingFace)
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2

# Vector store
CHROMA_PERSIST_DIR=./vector_store
COLLECTION_NAME=stackoverflow_python

# RAG config
TOP_K_RETRIEVAL=10
TOP_K_RERANK=3
MAX_NEW_TOKENS=1024

# App config
APP_HOST=0.0.0.0
APP_PORT=8000
